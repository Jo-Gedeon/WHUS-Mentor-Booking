# Copy this file to `.env` (in this same server/ folder) and fill in real
# values. `.env` is gitignored and must never be committed.

PORT=5000

# Path to your service account JSON key file. Keep the actual file out of
# git — see googleCalendarClient.js for setup steps.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Your Google Calendar's ID (usually just your email address).
GOOGLE_CALENDAR_ID=you@example.com
